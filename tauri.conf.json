{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunnel Manager",
  "version": "1.0.0",
  "identifier": "com.chrisdaggas.tunnelmanager",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tunnel Manager",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Network",
    "shortDescription": "Manage remotely configured Cloudflare Tunnels",
    "longDescription": "An unofficial desktop client for managing remotely configured Cloudflare Tunnels: their hostnames, their DNS records and — optionally, over SSH — the cloudflared service on the machines that serve them."
  }
}
